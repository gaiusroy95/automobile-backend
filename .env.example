NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins, or "*" for any. Include both your local dev URL and
# your deployed Vercel frontend's URL (e.g. https://your-app.vercel.app). Note: Vercel *preview*
# deployments get a new random subdomain per branch/PR — those won't match a fixed origin here
# unless you add each one, so CORS errors on preview URLs (not production) are expected.
CORS_ORIGIN=http://localhost:4200,https://your-app.vercel.app

# --- Firebase Admin credentials: pick ONE of the two strategies below ---

# Strategy 1 (used by default here): discrete fields lifted from your service account JSON.
# Works as a plain env var on Render — multi-line values (the private key) are supported as-is.
# ⚠️ Never put real values here — this file is committed to git. Real secrets go in `.env`
# (gitignored) or your deployment platform's environment variable UI, never in this template.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Strategy 2: point at a service-account JSON file instead (e.g. a Render "Secret File" mounted
# at /etc/secrets/firebase-service-account.json). If set, this takes precedence over Strategy 1.
# FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json

# Optional: point at a local Firestore emulator instead of production
# FIRESTORE_EMULATOR_HOST=localhost:8080

# Shared secret required to add a new automobile (POST /cars) — there's no user-account system
# in this app, so this is a single password gating the one write endpoint. Pick a long random
# value (e.g. `openssl rand -hex 32`); the frontend prompts for it once and sends it as the
# X-Admin-Key header.
ADMIN_API_KEY=change-me-to-a-long-random-value
